# Standalone build: needs NVCC and CUDA libraries, not PyTorch or a GPU.
# Run from the repository root:
#   make -f bench/Makefile.gemm_traversal
# B200: override CUDA_ARCH=sm_100a; default is B300 (sm_103a).
CUDA_HOME ?= /usr/local/cuda-13.2
CUDA_ARCH ?= sm_103a
CUDA_COMPUTE := $(subst sm_,compute_,$(CUDA_ARCH))
LOGICAL_DEVICES ?= 8
NVCC := $(CUDA_HOME)/bin/nvcc
TARGET := build/libgemm_traversal_$(CUDA_ARCH)_d$(LOGICAL_DEVICES).so
HEADERS := $(shell find include -name '*.cuh' -o -name '*.h')

.PHONY: all check-traversal
all: $(TARGET)

check-traversal: build/test_gemm_tile_traversal
	./build/test_gemm_tile_traversal

build/test_gemm_tile_traversal: tests/test_gemm_tile_traversal.cpp include/operators/ag_gemm/gemm_tile_traversal.h
	mkdir -p build
	$(CXX) -std=c++17 -O2 -Iinclude $< -o $@

$(TARGET): src/gemm_traversal_bench.cu src/ag_gemm_warp_specialized.cu $(HEADERS) bench/Makefile.gemm_traversal
	mkdir -p build
	$(NVCC) -O3 -std=c++20 --use_fast_math --extended-lambda --expt-relaxed-constexpr \
	    -gencode arch=$(CUDA_COMPUTE),code=$(CUDA_ARCH) -ccbin /usr/bin/g++ -lineinfo --ptxas-options=-v \
	    -DKITTENS_SM10X -DKITTENS_BLACKWELL -DMKERNEL_TCGEN05 \
	    -DMKERNEL_COMPILE_WITHOUT_TORCH -DINTRA_NUM_DEVICES=$(LOGICAL_DEVICES) \
	    -Iinclude -Xcompiler=-fPIC -shared $< -o $@ \
	    -L$(CUDA_HOME)/lib64 -L$(CUDA_HOME)/lib64/stubs -lcuda -lcublas \
	    -Xlinker -rpath -Xlinker $(CUDA_HOME)/lib64
